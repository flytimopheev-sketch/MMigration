# Политика PolicyKit сверяется в тесте с выводом PolkitManager::render_policy()
# (генерируется с LF). Принудительно фиксируем LF, чтобы на Linux и Windows
# файл совпадал побайтово и тест проходил.
migration-master/resources/com.redos.migration-master.policy text eol=lf

# Текстовые ресурсы, читаемые как YAML/TOML — тоже LF для стабильности.
migration-master/resources/examples/* text eol=lf
migration-master/src/** text eol=lf
migration-master/docs/** text eol=lf

# Скриншоты — бинарные файлы: нормализация переводов строк испортила бы PNG.
# Правило ниже перекрывает общее правило для docs/** (последнее совпадение
# выигрывает).
migration-master/docs/screenshots/*.png -text -diff -merge -eol
